{
  "expo": {
    "name": "ROOV",
    "slug": "ROOV",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "roov",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roov.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ROOV usa sua localização para mostrar experiências perto de você.",
        "NSCameraUsageDescription": "ROOV precisa da câmera para você registrar experiências.",
        "NSPhotoLibraryUsageDescription": "ROOV precisa acessar suas fotos para publicar experiências."
      }
    },
    "android": {
      "package": "com.roov.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#050505"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ROOV usa sua localização para mostrar experiências perto de você."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ROOV precisa acessar suas fotos para publicar experiências.",
          "cameraPermission": "ROOV precisa da câmera para registrar experiências."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
