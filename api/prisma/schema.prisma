// Schema do banco do ROOV.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis, pg_trgm]
}

// ─── Enums do domínio ────────────────────────────────────────────────────────
//
// Os valores replicam exatamente `domain/types.js` do frontend, em português.
// Traduzir para inglês aqui criaria uma tabela de conversão entre backend e
// frontend — camada que só existe para satisfazer preferência de idioma e que
// vaza erro toda vez que alguém esquece de atualizá-la.

enum UserStatus {
  novo
  ativo
  suspenso
  banido
  excluido
}

enum UserRole {
  usuario
  premium
  business
  moderador
  admin
}

// ─── Usuário ─────────────────────────────────────────────────────────────────

model User {
  id String @id @default(uuid()) @db.Uuid

  /// Credencial de acesso. Nunca exposta em respostas da API.
  email String @unique

  /// Hash Argon2id. A senha em texto puro nunca é persistida nem registrada em log.
  passwordHash String @map("password_hash")

  /// Identificador público (@handle). Único e imutável nesta fase.
  username String @unique

  name String

  // Campos de perfil. Opcionais porque o cadastro do MVP pede só o essencial;
  // o preenchimento é responsabilidade da Fase 3.
  avatar  String?
  bio     String?
  city    String?
  state   String?
  country String?

  /// Preferência declarada, não comportamento observado — por isso não entra
  /// em `buildUserDna` (Cap. 57) ainda: o DNA é construído do que a pessoa
  /// vive, não do que marca numa lista. Guardado para quando o onboarding ou
  /// um cold start precisar de um sinal inicial, antes de haver histórico.
  preferredCategories PlaceCategory[] @default([]) @map("preferred_categories")

  /// Verificado por código de 6 dígitos enviado por e-mail no cadastro, não
  /// a cada login. Não bloqueia nenhuma rota hoje — é só o estado visível
  /// pro frontend decidir se mostra o aviso "confirme seu e-mail".
  emailVerified Boolean @default(false) @map("email_verified")

  status UserStatus @default(novo)
  role   UserRole   @default(usuario)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshTokens      RefreshToken[]
  places             Place[]
  savedPlaces        SavedPlace[]
  verificationCodes  EmailVerificationCode[]

  @@map("users")
}

/// Código de verificação de e-mail — ponte de confiança até existir um
/// provedor de e-mail transacional de verdade na infraestrutura (hoje:
/// Resend, com fallback de logar o código no servidor se a chave não
/// estiver configurada, ver `MailService`).
model EmailVerificationCode {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 do código, nunca o código em si — mesmo raciocínio do refresh
  /// token (`TokenService.hashRefreshToken`): dump do banco não expõe
  /// código ativo.
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")

  /// Tentativas erradas nesta linha. Trava depois de 5 — força reenvio, não
  /// permite força bruta sobre 10^6 combinações de um código de 6 dígitos.
  attempts Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_verification_codes")
}

// ─── Sessão ──────────────────────────────────────────────────────────────────

/// Refresh token persistido.
///
/// Existe por um motivo só: tornar o logout real. Um access token JWT não é
/// revogável — vale até expirar, aconteça o que acontecer. Guardando o refresh
/// token no banco, encerrar sessão passa a ter efeito no servidor, e uma
/// sessão comprometida pode ser cortada.
model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  /// SHA-256 do token, nunca o token em si.
  ///
  /// Se o banco vazar, os tokens não são utilizáveis. SHA-256 e não Argon2 de
  /// propósito: o token é 32 bytes aleatórios, portanto imune a ataque de
  /// dicionário. Argon2 aqui só somaria centenas de milissegundos a cada
  /// renovação, sem ganho de segurança.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  /// Usado no logout global e na detecção de reuso.
  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Lugares ─────────────────────────────────────────────────────────────────

enum PlaceCategory {
  entretenimento
  gastronomia
  natureza
  passeios
}

enum PlaceStatus {
  novo
  ativo
  arquivado
  oculto
}

/// A entidade mais importante do produto (Cap. 39 do frontend).
///
/// Sem `distanceKm`: é projeção de consulta (depende de quem pergunta e de
/// onde), nunca um atributo do lugar — armazená-lo impediria cache
/// compartilhado entre usuários. Sem `postsCount`/`savesCount`: são
/// derivados de Posts (Fase 5), que ainda não existe. `seedTags` é exceção
/// deliberada, ver EMENDA-004.
model Place {
  id String @id @default(uuid()) @db.Uuid

  name      String
  category  PlaceCategory
  placeType String        @map("place_type")

  neighborhood String
  city         String
  state        String
  country      String

  /// Plain columns, não `geography`: Prisma não suporta tipos PostGIS
  /// nativamente (ver `docs/FASE-1-DECISOES-TECNICAS.md`, D4). O índice
  /// GiST funcional sobre estas duas colunas é criado à mão na migration.
  latitude  Float @db.DoublePrecision
  longitude Float @db.DoublePrecision

  photos     String[]
  priceRange Int      @map("price_range")

  /// `{ open: "HH:MM", close: "HH:MM", closedOn?: number[] }` — espelha
  /// exatamente o formato de `domain/types.js` do frontend.
  hours Json

  /// Semente de curadoria manual para o DNA do lugar — ponte temporária até
  /// Posts (Fase 5) existir de verdade. Formato:
  /// `{ ambiente: string[], vibe: string[], publico: string[], perfil: string[] }`.
  /// Ver EMENDA-004.
  seedTags Json? @map("seed_tags")

  status PlaceStatus @default(novo)

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("places")
}

// ─── Salvos ──────────────────────────────────────────────────────────────────

enum SavedPlaceKind {
  favorito
  quero
  vivido
}

/// "Quero ir" / "já fui" / favorito — Cap. 22, corte simples (sem Agenda).
///
/// `placeId` é texto solto, não FK pro `Place`: a lista hoje mistura lugares
/// mockados (ids como "p-dom") com reais (uuid do Postgres), e Salvos precisa
/// funcionar pros dois até o mock sair de cena de vez. Perde integridade
/// referencial de propósito — a alternativa (só aceitar lugar real) deixaria
/// metade dos lugares exibidos sem poder ser salvos, pior do que isso.
model SavedPlace {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  placeId String         @map("place_id")
  kind    SavedPlaceKind

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, placeId, kind])
  @@index([userId])
  @@map("saved_places")
}
