# ─── Aplicação ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173

# ─── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://roov:roov@127.0.0.1:5432/roov?schema=public
# Usada apenas por migrations. Idêntica à DATABASE_URL em Postgres comum;
# difere quando o banco está atrás de um pooler em modo transaction.
DIRECT_URL=postgresql://roov:roov@127.0.0.1:5432/roov?schema=public

# ─── Autenticação ─────────────────────────────────────────────────────────────
# Gere um segredo real com:  openssl rand -base64 48
# NUNCA reutilize o valor abaixo fora de desenvolvimento.
JWT_SECRET=troque-este-valor-por-um-segredo-com-no-minimo-32-caracteres
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─── E-mail transacional ──────────────────────────────────────────────────────
# Código de verificação do cadastro. Sem a chave, o código só é logado no
# servidor (modo de desenvolvimento) — a API sobe normalmente do mesmo jeito.
# Crie uma conta grátis em resend.com e gere uma chave em API Keys.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ─── Observabilidade ──────────────────────────────────────────────────────────
LOG_LEVEL=debug
